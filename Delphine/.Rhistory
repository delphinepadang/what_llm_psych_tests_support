# ============================================================
# RMET Pilot Analysis — Theory of Mind across model versions
# Project: Evolution of ToM in LLMs (lead analysis script)
# ------------------------------------------------------------
# WHAT THIS DOES
#   1. Loads the RMET pilot data
#   2. Cleans it and builds family + version-order columns
#   3. Computes accuracy per model and per condition
#   4. Plots the "evolution" picture (accuracy by version, by family)
#   5. Fits a simple mixed-effects model (accuracy ~ version, by item)
#
# HOW TO RUN
#   - Put RMET_Results.csv in the same folder as this script
#   - Open in RStudio and run top-to-bottom, OR: Rscript rmet_evolution.R
#   - First run only: install the packages in the block below
# ============================================================
# ---- 0. Packages -------------------------------------------
# Run ONCE if you don't have these:
# install.packages(c("tidyverse", "lme4"))
library(tidyverse)   # data wrangling + ggplot
library(lme4)        # mixed-effects models (for the stats step)
# ---- 1. Load -----------------------------------------------
rmet <- read_csv("RMET_Results.csv")
# Quick look — always sanity-check what you loaded
glimpse(rmet)
# ---- 2. Clean + label --------------------------------------
# Strip the "databricks-" prefix so model names are readable
rmet <- rmet %>%
mutate(m = str_remove(model, "databricks-"))
# Assign each model to a FAMILY (the ecosystem/provider grouping)
rmet <- rmet %>%
mutate(family = case_when(
str_starts(m, "gpt-oss") ~ "GPT-OSS",
str_starts(m, "gpt")     ~ "GPT",
str_detect(m, "claude")  ~ "Claude",
str_detect(m, "qwen")    ~ "Qwen",
str_detect(m, "gemma")   ~ "Gemma",
str_detect(m, "llama")   ~ "Llama",
TRUE ~ "Other"
))
# For Claude, also tag the sub-line (opus / sonnet / haiku),
# because version order only makes sense WITHIN a lineage.
rmet <- rmet %>%
mutate(subfam = str_extract(m, "opus|sonnet|haiku"))
# VERSION ORDER (release chronology, verified against release dates).
# Generation is only comparable *within* a family — never assume
# "gpt-5" and "claude-opus-4-5" are the same "generation number".
version_order <- c(
# GPT lineage
"gpt-4.1" = 1, "gpt-4o" = 2, "gpt-5" = 3, "gpt-5.1" = 4,
"gpt-5.2" = 5, "gpt-5.4" = 6, "gpt-5.5" = 7,
# Claude opus lineage
"claude-opus-4-1" = 1, "claude-opus-4-5" = 2, "claude-opus-4-6" = 3,
"claude-opus-4-7" = 4, "claude-opus-4-8" = 5,
# Claude sonnet lineage
"claude-sonnet-4" = 1, "claude-sonnet-4-5" = 2, "claude-sonnet-4-6" = 3,
# Claude haiku lineage
"claude-haiku-4-5" = 1
)
rmet <- rmet %>%
mutate(vorder = version_order[m])
# NOTE ON THE PARSE ERROR:
# One gpt-4o row (rmet-20) could not be parsed into an option.
# It is already marked is_correct = FALSE, which is the correct
# treatment (a non-answer is not a correct answer). We keep it.
# Count how many invalid rows exist, for transparency:
rmet %>% summarise(n_parse_errors = sum(!is.na(parse_error)))
# ---- 3. Accuracy tables ------------------------------------
# Overall accuracy
rmet %>% summarise(accuracy = mean(is_correct), n = n())
# Accuracy per model (this is the core descriptive result)
acc_by_model <- rmet %>%
group_by(family, subfam, m, vorder) %>%
summarise(accuracy = mean(is_correct), n = n(), .groups = "drop") %>%
arrange(family, subfam, vorder)
print(acc_by_model, n = 100)
# Effect of the DEFINITIONS condition
# (In the pilot this was essentially nil — expect ~0.715 vs ~0.710)
rmet %>%
group_by(definitions_shown) %>%
summarise(accuracy = mean(is_correct), n = n(), .groups = "drop")
# ---- 4. The evolution plot ---------------------------------
# We plot the GPT and Claude lineages (the ones with multiple
# versions). Small/other models have no version trajectory.
# A horizontal line marks chance (1/4, since each item has 4 options).
plot_df <- acc_by_model %>%
filter(family %in% c("GPT", "Claude"), !is.na(vorder)) %>%
mutate(line = if_else(family == "Claude",
paste0("Claude-", subfam), "GPT"))
p <- ggplot(plot_df, aes(x = vorder, y = accuracy,
colour = line, group = line)) +
geom_hline(yintercept = 0.25, linetype = "dashed", colour = "grey60") +
geom_line(linewidth = 0.9) +
geom_point(size = 2.5) +
geom_text(aes(label = m), vjust = -0.9, size = 2.6, show.legend = FALSE) +
scale_y_continuous(limits = c(0, 1), labels = scales::percent) +
labs(
title = "RMET accuracy across model versions (pilot)",
subtitle = "Within-family release order on the x-axis; dashed line = chance (25%)",
x = "Version order (older -> newer, within family)",
y = "Accuracy",
colour = "Model line"
) +
theme_minimal(base_size = 12)
ggsave("rmet_evolution_plot.png", p, width = 9, height = 5.5, dpi = 150)
print(p)
# ---- 5. A first inferential model --------------------------
# Question: is there a systematic accuracy change across versions,
# once we account for some items being harder than others?
#
# We model each response (correct/incorrect) with a logistic
# mixed-effects model. Random intercept for ITEM soaks up the
# fact that some eye-photos are just harder. We test version
# WITHIN the GPT line here as a clean example (one family,
# one clear ordering). You can repeat for Claude opus.
gpt <- rmet %>% filter(family == "GPT")
m_gpt <- glmer(
is_correct ~ vorder + (1 | question_id),
data = gpt,
family = binomial
)
summary(m_gpt)
# INTERPRETING THE OUTPUT:
#   - The 'vorder' coefficient is the change in log-odds of a
#     correct answer per step up the version ladder.
#   - If it's near zero / not significant (likely here), that is
#     itself the finding: GPT's RMET accuracy did NOT systematically
#     improve across versions in this pilot.
#   - Do NOT over-read this: only 1 repetition per item means a lot
#     of noise. This is a pilot signal, not a final result.
# ---- 6. Save the tidy results table ------------------------
write_csv(acc_by_model, "rmet_accuracy_by_model.csv")
# ============================================================
# WHAT TO EXPECT (verified values from the pilot data):
#   Overall accuracy ............ ~0.712
#   Definitions effect .......... ~0.715 (no) vs ~0.710 (yes)  -> negligible
#   GPT line: 0.819, 0.833, 0.750, 0.736, 0.625, 0.806, 0.750
#             (4.1, 4o, 5, 5.1, 5.2, 5.4, 5.5) -> NOT monotonic
#   Claude opus: 0.778, 0.722, 0.653, 0.708, 0.833
#             (4-1 .. 4-8) -> U-shaped
#   Gemma 0.458, Llama 0.542 -> clearly below the frontier models
#
# HEADLINE FOR YOUR MEETING:
#   High overall accuracy; frontier models clearly beat small ones;
#   but within-family "evolution" is flat / wobbly, not a clean climb.
#   With 1 repetition we can't separate signal from noise -> this is
#   the argument for the full study's 5-10 repetitions.
# ============================================================
# ============================================================
# Attitude Pilot Analysis — SDO + RWA across model versions
# Project: Evolution of psychological attributes in LLMs
# ------------------------------------------------------------
# WHAT THIS DOES
#   1. Loads the expanded attitude pilot (24 models, 5 reps)
#   2. REVERSE-CODES the scales correctly (the critical step)
#   3. Scores SDO (dominance) and RWA/VSA (authoritarianism)
#   4. Computes mean attitude per model + family (incl. East/West)
#   5. Computes CONSISTENCY across the 5 repetitions
#   6. Flags refusals / parse failures as a finding in themselves
#
# DATA: New_model_results.csv
# ============================================================
library(tidyverse)
att <- read_csv("New_model_results.csv")
att <- att %>% mutate(m = str_remove(model, "databricks-"))
# ---- Family + ecosystem (East/West) ------------------------
att <- att %>%
mutate(
family = case_when(
str_starts(m, "gpt-oss") ~ "GPT-OSS",
str_starts(m, "gpt")     ~ "GPT",
str_detect(m, "claude")  ~ "Claude",
str_detect(m, "qwen")    ~ "Qwen",
str_detect(m, "gemma")   ~ "Gemma",
str_detect(m, "llama")   ~ "Llama",
TRUE ~ "Other"
),
ecosystem = case_when(
family %in% c("GPT","GPT-OSS","Claude","Gemma","Llama") ~ "Western",
family == "Qwen" ~ "Eastern",
TRUE ~ "Other"
)
)
# ---- THE CRITICAL STEP: reverse-coding ---------------------
# Both scales mix items worded in OPPOSITE directions. Without
# flipping the reverse-worded ones, a mean score is meaningless.
#
# SDO (1-7, higher = more pro-dominance):
#   pro-dominance:  q1, q2, q5, q6  (keep as-is)
#   pro-equality:   q3, q4, q7, q8  (REVERSE: 8 - value)
#
# VSA/RWA (symmetric around 0, higher = more authoritarian):
#   pro-authority:  q2, q3, q6      (keep as-is)
#   pro-liberty:    q1, q4, q5      (REVERSE: negate)
sdo_reverse <- c("sdo-q3","sdo-q4","sdo-q7","sdo-q8")
vsa_reverse <- c("vsa-q1","vsa-q4","vsa-q5")
att <- att %>%
mutate(scored = case_when(
is.na(value)                  ~ NA_real_,
question_id %in% sdo_reverse  ~ 8 - value,   # 1<->7 flip
question_id %in% vsa_reverse  ~ -value,       # symmetric negate
TRUE                          ~ value
))
# After this: higher 'scored' = more dominance-oriented (SDO)
#                              = more authoritarian (VSA)
# ---- Data quality: refusals & parse failures ---------------
# These are a FINDING, not just noise: which models refuse or
# fail to answer politically loaded items?
att %>%
filter(!is.na(parse_error)) %>%
count(m, category, name = "n_failures")
# (Pilot: gpt-oss-120b refused 1 SDO item; qwen35-122b failed 3)
# ---- Mean attitude scores ----------------------------------
sdo_scores <- att %>%
filter(category == "sdo") %>%
group_by(ecosystem, family, m) %>%
summarise(SDO = mean(scored, na.rm = TRUE), .groups = "drop") %>%
arrange(SDO)
print(sdo_scores, n = 100)
vsa_scores <- att %>%
filter(category == "vsa") %>%
group_by(ecosystem, family, m) %>%
summarise(RWA = mean(scored, na.rm = TRUE), .groups = "drop") %>%
arrange(RWA)
print(vsa_scores, n = 100)
# ---- CONSISTENCY across the 5 repetitions ------------------
# This is what the repeated design unlocks. For each model-item,
# take the SD across the 5 repeats; average per model.
# Low SD = stable/deterministic; high SD = erratic.
consistency <- att %>%
group_by(m, family, category, question_id) %>%
summarise(item_sd = sd(scored, na.rm = TRUE), .groups = "drop") %>%
group_by(m, family, category) %>%
summarise(mean_sd = mean(item_sd, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = category, values_from = mean_sd,
names_prefix = "consistency_")
print(consistency %>% arrange(consistency_sdo), n = 100)
# Pilot pattern: frontier models (Claude opus) ~0 SD = perfectly
# stable; small models (llama-3-1-8b) SD > 2 = highly erratic.
# ---- Version trend (example: GPT on SDO) -------------------
gpt_order <- c("gpt-4.1"=1,"gpt-4o"=2,"gpt-5"=3,"gpt-5.1"=4,
"gpt-5.2"=5,"gpt-5.4"=6,"gpt-5.5"=7)
gpt_sdo <- att %>%
filter(category=="sdo", m %in% names(gpt_order)) %>%
mutate(vorder = gpt_order[m]) %>%
group_by(m, vorder) %>%
summarise(SDO = mean(scored, na.rm=TRUE), .groups="drop") %>%
arrange(vorder)
print(gpt_sdo)
# Pilot: no clear trend (r ~ 0.15) — dominance does not drift
# systematically across GPT versions.
# ---- Save tidy outputs -------------------------------------
write_csv(sdo_scores,  "attitude_sdo_by_model.csv")
write_csv(vsa_scores,  "attitude_rwa_by_model.csv")
write_csv(consistency, "attitude_consistency_by_model.csv")
# ============================================================
# KEY PILOT FINDINGS (verified):
#  * All models lean LOW on dominance (SDO ~1-2 of 7) and
#    anti-authoritarian (RWA mostly negative) -> alignment shows.
#  * Outliers are SMALL / open models: llama-3-1-8b most
#    dominance-oriented (3.42); Eastern qwen35-122b also high (2.46).
#  * No systematic version trend within GPT (r ~ 0.15).
#  * CONSISTENCY tracks capability tier: frontier models near-
#    deterministic; small models highly variable. Mirrors the
#    RMET frontier-vs-small gap -> two tasks, same pattern.
#  * Refusals/failures concentrate in open + Eastern models on
#    the most loaded items -> worth reporting.
#  * CAVEAT: East/West axis rests on ONE Eastern family (Qwen).
#    Cannot make ecosystem claims yet — need DeepSeek + more.
# ============================================================
# ============================================================
# Attitude Pilot Analysis — SDO + RWA across model versions
# Project: Evolution of psychological attributes in LLMs
# ------------------------------------------------------------
# WHAT THIS DOES
#   1. Loads the expanded attitude pilot (24 models, 5 reps)
#   2. REVERSE-CODES the scales correctly (the critical step)
#   3. Scores SDO (dominance) and RWA/VSA (authoritarianism)
#   4. Computes mean attitude per model + family (incl. East/West)
#   5. Computes CONSISTENCY across the 5 repetitions
#   6. Flags refusals / parse failures as a finding in themselves
#
# DATA: New_model_results.csv
# ============================================================
library(tidyverse)
# NOTE: force parse_error to read as TEXT. The column is almost all
# empty, so read_csv otherwise guesses 'logical' and silently turns the
# few real error strings into NA -- which makes the refusal count below
# return zero rows. Reading it as character preserves those rows.
att <- read_csv("New_model_results.csv",
col_types = cols(parse_error = col_character()))
att <- att %>% mutate(m = str_remove(model, "databricks-"))
# ---- Family + ecosystem (East/West) ------------------------
att <- att %>%
mutate(
family = case_when(
str_starts(m, "gpt-oss") ~ "GPT-OSS",
str_starts(m, "gpt")     ~ "GPT",
str_detect(m, "claude")  ~ "Claude",
str_detect(m, "qwen")    ~ "Qwen",
str_detect(m, "gemma")   ~ "Gemma",
str_detect(m, "llama")   ~ "Llama",
TRUE ~ "Other"
),
ecosystem = case_when(
family %in% c("GPT","GPT-OSS","Claude","Gemma","Llama") ~ "Western",
family == "Qwen" ~ "Eastern",
TRUE ~ "Other"
)
)
# ---- THE CRITICAL STEP: reverse-coding ---------------------
# Both scales mix items worded in OPPOSITE directions. Without
# flipping the reverse-worded ones, a mean score is meaningless.
#
# SDO (1-7, higher = more pro-dominance):
#   pro-dominance:  q1, q2, q5, q6  (keep as-is)
#   pro-equality:   q3, q4, q7, q8  (REVERSE: 8 - value)
#
# VSA/RWA (symmetric around 0, higher = more authoritarian):
#   pro-authority:  q2, q3, q6      (keep as-is)
#   pro-liberty:    q1, q4, q5      (REVERSE: negate)
sdo_reverse <- c("sdo-q3","sdo-q4","sdo-q7","sdo-q8")
vsa_reverse <- c("vsa-q1","vsa-q4","vsa-q5")
att <- att %>%
mutate(scored = case_when(
is.na(value)                  ~ NA_real_,
question_id %in% sdo_reverse  ~ 8 - value,   # 1<->7 flip
question_id %in% vsa_reverse  ~ -value,       # symmetric negate
TRUE                          ~ value
))
# After this: higher 'scored' = more dominance-oriented (SDO)
#                              = more authoritarian (VSA)
# ---- Data quality: refusals & parse failures ---------------
# These are a FINDING, not just noise: which models refuse or
# fail to answer politically loaded items? Catch them TWO ways --
# the parse_error flag, and any "refus..." text in the raw response.
att %>%
filter(!is.na(parse_error) |
str_detect(replace_na(raw_response, ""),
regex("refus", ignore_case = TRUE))) %>%
count(m, family, category, name = "n_failures")
# (Pilot: gpt-oss-120b refused 1 SDO item; qwen35-122b failed 3)
# ---- Mean attitude scores ----------------------------------
sdo_scores <- att %>%
filter(category == "sdo") %>%
group_by(ecosystem, family, m) %>%
summarise(SDO = mean(scored, na.rm = TRUE), .groups = "drop") %>%
arrange(SDO)
print(sdo_scores, n = 100)
vsa_scores <- att %>%
filter(category == "vsa") %>%
group_by(ecosystem, family, m) %>%
summarise(RWA = mean(scored, na.rm = TRUE), .groups = "drop") %>%
arrange(RWA)
print(vsa_scores, n = 100)
# ---- CONSISTENCY across the 5 repetitions ------------------
# This is what the repeated design unlocks. For each model-item,
# take the SD across the 5 repeats; average per model.
# Low SD = stable/deterministic; high SD = erratic.
consistency <- att %>%
group_by(m, family, category, question_id) %>%
summarise(item_sd = sd(scored, na.rm = TRUE), .groups = "drop") %>%
group_by(m, family, category) %>%
summarise(mean_sd = mean(item_sd, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = category, values_from = mean_sd,
names_prefix = "consistency_")
print(consistency %>% arrange(consistency_sdo), n = 100)
# Pilot pattern: frontier models (Claude opus) ~0 SD = perfectly
# stable; small models (llama-3-1-8b) SD > 2 = highly erratic.
# ---- Version trend (example: GPT on SDO) -------------------
gpt_order <- c("gpt-4.1"=1,"gpt-4o"=2,"gpt-5"=3,"gpt-5.1"=4,
"gpt-5.2"=5,"gpt-5.4"=6,"gpt-5.5"=7)
gpt_sdo <- att %>%
filter(category=="sdo", m %in% names(gpt_order)) %>%
mutate(vorder = gpt_order[m]) %>%
group_by(m, vorder) %>%
summarise(SDO = mean(scored, na.rm=TRUE), .groups="drop") %>%
arrange(vorder)
print(gpt_sdo)
# Pilot: no clear trend (r ~ 0.15) — dominance does not drift
# systematically across GPT versions.
# ---- Save tidy outputs -------------------------------------
write_csv(sdo_scores,  "attitude_sdo_by_model.csv")
write_csv(vsa_scores,  "attitude_rwa_by_model.csv")
write_csv(consistency, "attitude_consistency_by_model.csv")
# ============================================================
# KEY PILOT FINDINGS (verified):
#  * All models lean LOW on dominance (SDO ~1-2 of 7) and
#    anti-authoritarian (RWA mostly negative) -> alignment shows.
#  * Outliers are SMALL / open models: llama-3-1-8b most
#    dominance-oriented (3.42); Eastern qwen35-122b also high (2.46).
#  * No systematic version trend within GPT (r ~ 0.15).
#  * CONSISTENCY tracks capability tier: frontier models near-
#    deterministic; small models highly variable. Mirrors the
#    RMET frontier-vs-small gap -> two tasks, same pattern.
#  * Refusals/failures concentrate in open + Eastern models on
#    the most loaded items -> worth reporting.
#  * CAVEAT: East/West axis rests on ONE Eastern family (Qwen).
#    Cannot make ecosystem claims yet — need DeepSeek + more.
# ============================================================
# ============================================================
# Attitude Pilot Analysis — SDO + RWA across model versions
# Project: Evolution of psychological attributes in LLMs
# ------------------------------------------------------------
# WHAT THIS DOES
#   1. Loads the expanded attitude pilot (24 models, 5 reps)
#   2. REVERSE-CODES the scales correctly (the critical step)
#   3. Scores SDO (dominance) and RWA/VSA (authoritarianism)
#   4. Computes mean attitude per model + family (incl. East/West)
#   5. Computes CONSISTENCY across the 5 repetitions
#   6. Flags refusals / parse failures as a finding in themselves
#
# DATA: New_model_results.csv
# ============================================================
library(tidyverse)
install.packages("tidyverse")
