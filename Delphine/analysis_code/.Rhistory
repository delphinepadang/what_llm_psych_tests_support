full_sdo  = enum_doubled(dat$consistency_sdo, dat$access == "open-weight"),
full_vsa  = enum_doubled(dat$consistency_vsa, dat$access == "open-weight"),
restr_sdo = enum_doubled(c(cl_d$consistency_sdo, ow_d$consistency_sdo),
rep(c(FALSE, TRUE), c(9, 8))),
restr_vsa = enum_doubled(c(cl_d$consistency_vsa, ow_d$consistency_vsa),
rep(c(FALSE, TRUE), c(9, 8))))
cat("    enumeration:   ", paste(sprintf("%s=%.6f", names(ed), ed), collapse = "  "), "\n")
check("6.6/B1 wilcox.test == doubled-tail enumeration (all four, < 1e-9)",
max(abs(p4 - ed)) < 1e-9)
}
# ---- tally ---------------------------------------------------------------------
fails <- sum(!vapply(.results, function(x) x$ok, logical(1)))
cat(sprintf("\n==== %d checks run, %d failed ====\n", length(.results), fails))
if (fails == 0) {
cat("All \u00a76 expectations reproduced from the full-precision files.\n",
"-> The qmd's [VERIFY-R] tags were already cleared 8 July; nothing further there.\n",
"-> Transplant the 6.6 fold-in block into verify_section3_stats.R for the deposit.\n",
"-> 6.3 output above = the OPTIONAL 4.1 / candidate-B13 numbers (with Kangning).\n",
"-> Settle worklist 7.5: regenerate table2_check.csv at full precision, or keep\n",
"   it documented as the rendered-table check target (see check 6.0).\n", sep = "")
} else {
stop("Some expectations failed - investigate before relying on the affected values.")
}
# verify_section3_stats_v2.R — v2, 8 July 2026
# ---------------------------------------------------------------------------
# Reproduces, in manuscript order, every statistic reported in §3 of
# MS_AAI_manuscript.qmd from the three model-level aggregate CSVs, then
# (new in v2) the Holm / floor-coupling / enumeration supplement transplanted
# from verify_section6.R §6.6.
#
# v2 changes (computation paths unchanged unless noted):
#   (1) Header test note corrected: from R 4.6, wilcox.test computes the exact
#       conditional distribution WITH ties (no warning; the v1 note predated
#       the 7 July resolution — this script's own output prints "Wilcoxon rank
#       sum exact test"). Two-sided p = twice the smaller one-sided tail,
#       verified against the full enumeration at the end of this script.
#   (2) Rank-biserial flipped to the manuscript's standardized convention:
#       positive = higher open-weight dispersion (r = .29 / .49 / .36 / .65).
#   (3) Stale expected values in section headers corrected
#       (.052 not .055; .021 not .024; median display .07 / .74 not .08 / .75).
#   (4) table2_check.csv write retained, with a provenance comment: the file
#       is the rounded (2dp) diff-target for the rendered Table 2 by design.
#   (5) §6.6 supplement appended (Holm, floor-coupling, doubled-tail
#       enumeration with a hard assertion on the §2.5 exactness claim).
#
# Run: Rscript verify_section3_stats_v2.R   (data_summaries auto-discovered;
#      or set AAI_DATA_DIR / pass the folder as the first argument).
# Requires R >= 4.6 and tidyverse. Hard assertions for every quantity live in
# verify_section6.R; this script prints against expected-value comments, per
# its original idiom. R's W is the U reported in §3.2 (first-listed group:
# flagship / Claude).
# ---------------------------------------------------------------------------
if (getRversion() < "4.6")
stop("R >= 4.6 required: wilcox.test computes exact p-values with ties only ",
"from 4.6; on older versions the same calls silently fall back to a ",
"normal approximation and the expected values below will not reproduce.")
library(tidyverse)
# ---- data location (standard path block — identical across the R scripts) -----
# Reads inputs from, and writes outputs to, the `data_summaries` folder that sits
# next to `analysis_code/`. Resolution order:
#   (1) env var AAI_DATA_DIR  (2) first command-line arg  (3) a `data_summaries`
#   folder found next to this script or one level up. Nothing to edit to run from
#   inside analysis_code/ or from the project root; override only if you move data.
.aai_script_dir <- function() {
fa <- grep("^--file=", commandArgs(FALSE), value = TRUE)
if (length(fa)) return(normalizePath(dirname(sub("^--file=", "", fa[[1]]))))
for (i in seq_len(sys.nframe())) {
of <- sys.frame(i)$ofile
if (!is.null(of)) return(normalizePath(dirname(of)))
}
normalizePath(getwd())
}
.aai_find_data <- function() {
env <- Sys.getenv("AAI_DATA_DIR", "")
if (nzchar(env)) return(normalizePath(env))
a <- commandArgs(trailingOnly = TRUE)
if (length(a) >= 1 && nzchar(a[[1]])) return(normalizePath(a[[1]]))
for (cand in c(file.path(.aai_script_dir(), "data_summaries"),
file.path(.aai_script_dir(), "..", "data_summaries"),
file.path(getwd(), "data_summaries"))) {
if (dir.exists(cand)) return(normalizePath(cand))
}
stop("Could not find the 'data_summaries' folder. Set AAI_DATA_DIR, pass it as ",
"the first argument, or run from inside the project.", call. = FALSE)
}
DATA_DIR <- .aai_find_data()
in_path  <- function(f) file.path(DATA_DIR, f)
out_path <- function(f) file.path(DATA_DIR, f)
message("[paths] data_summaries -> ", DATA_DIR)
# -------------------------------------------------------------------------------
sdo <- read_csv(in_path("attitude_sdo_by_model.csv"), show_col_types = FALSE)
rwa <- read_csv(in_path("attitude_rwa_by_model.csv"), show_col_types = FALSE)
con <- read_csv(in_path("attitude_consistency_by_model.csv"), show_col_types = FALSE)
d <- sdo |>
inner_join(rwa |> select(m, RWA), by = "m") |>
inner_join(con |> select(m, consistency_sdo, consistency_vsa), by = "m") |>
mutate(
access   = if_else(family %in% c("Claude", "GPT"), "flagship", "open-weight"),
provider = if_else(family == "GPT", "Azure", "Databricks")
)
stopifnot(nrow(d) == 24)   # 24 models, per Table 1
# Rank-biserial from U/W — v2: manuscript's standardized convention,
# positive = higher open-weight dispersion.
rb <- function(W, n1, n2) 1 - 2 * W / (n1 * n2)
# ===========================================================================
# §3.1 Dispositional placement
# ===========================================================================
cat("\n== §3.1 SDO: grand mean 1.64, median 1.49, range 1.00–3.42, all 24 < 4 ==\n")
d |> summarise(mean = mean(SDO), median = median(SDO),
min = min(SDO), max = max(SDO), n_below_mid = sum(SDO < 4)) |> print()
cat("\n== §3.1 VSA: grand mean −0.82, median −0.77, range −1.80–0.20, 21 of 24 < 0 ==\n")
d |> summarise(mean = mean(RWA), median = median(RWA),
min = min(RWA), max = max(RWA), n_below_mid = sum(RWA < 0)) |> print()
cat("\n== §3.1 the three at/above the VSA midpoint (GPT-4o +0.20; GPT-OSS-20B +0.13; Qwen3.5 0.00) ==\n")
d |> filter(RWA >= 0) |> select(m, RWA) |> print()
cat("\n== §3.1 family means: SDO 1.45 (Gemma) – 2.18 (Llama); VSA −1.34 (Llama) – −0.38 (GPT-OSS) ==\n")
d |> group_by(family) |>
summarise(SDO = mean(SDO), VSA = mean(RWA), .groups = "drop") |>
arrange(SDO) |> print()
cat("\n== §3.1 extremes: min SDO qwen3-next (1.00), max llama-3.1-8b (3.42) ==\n")
d |> slice_min(SDO, n = 1) |> select(m, SDO) |> print()
d |> slice_max(SDO, n = 1) |> select(m, SDO) |> print()
# ===========================================================================
# §3.2 Response stability
# ===========================================================================
cat("\n== §3.2 dispersion ranges: SDO 0–1.40, VSA 0–2.19 ==\n")
d |> summarise(across(c(consistency_sdo, consistency_vsa),
list(min = min, max = max))) |> print()
cat("\n== §3.2 '14 of 24 identical on ≥1 scale; none on both' ==\n")
d |> summarise(
zero_on_at_least_one = sum(consistency_sdo == 0 | consistency_vsa == 0),
zero_on_both         = sum(consistency_sdo == 0 & consistency_vsa == 0)
) |> print()
cat("\n== §3.2 medians by access: SDO 0.06 vs 0.23; VSA 0.07 vs 0.74 ==\n")
d |> group_by(access) |>
summarise(med_sdo = median(consistency_sdo),
med_vsa = median(consistency_vsa), .groups = "drop") |> print()
cat("\n== §3.2 full-sample tests: SDO U = 45.5, p = .26; VSA U = 32.5, p = .052 ==\n")
w1 <- wilcox.test(consistency_sdo ~ access, data = d)
print(w1); cat("rank-biserial r =", round(rb(w1$statistic, 16, 8), 2), " (manuscript: 0.29)\n")
w2 <- wilcox.test(consistency_vsa ~ access, data = d)
print(w2); cat("rank-biserial r =", round(rb(w2$statistic, 16, 8), 2), " (manuscript: 0.49)\n")
cat("\n== §3.2 Databricks-restricted: SDO U = 23.0, p = .21, r = .36; VSA U = 12.5, p = .021, r = .65 ==\n")
db <- d |> filter(provider == "Databricks") |>
mutate(grp = if_else(family == "Claude", "claude", "open-weight"))
stopifnot(sum(db$grp == "claude") == 9, sum(db$grp == "open-weight") == 8)
w3 <- wilcox.test(consistency_sdo ~ grp, data = db)
print(w3); cat("rank-biserial r =", round(rb(w3$statistic, 9, 8), 2), " (manuscript: 0.36)\n")
w4 <- wilcox.test(consistency_vsa ~ grp, data = db)
print(w4); cat("rank-biserial r =", round(rb(w4$statistic, 9, 8), 2), " (manuscript: 0.65)\n")
cat("\n== §3.2 structure: top-3 VSA dispersion all open-weight; Claude max 0.23; GPT SDO 0–0.30, VSA 0–0.85 ==\n")
d |> slice_max(consistency_vsa, n = 3) |> select(m, access, consistency_vsa) |> print()
d |> slice_max(consistency_sdo, n = 4) |> select(m, access, consistency_sdo) |> print()
d |> filter(family == "Claude") |>
summarise(claude_max_disp = max(pmax(consistency_sdo, consistency_vsa))) |> print()
d |> filter(family == "GPT") |>
summarise(sdo_min = min(consistency_sdo), sdo_max = max(consistency_sdo),
vsa_min = min(consistency_vsa), vsa_max = max(consistency_vsa)) |> print()
# ===========================================================================
# §3.3 Ecosystem (descriptive)
# ===========================================================================
cat("\n== §3.3 the two Qwen models ==\n")
d |> filter(ecosystem == "Eastern") |>
select(m, SDO, RWA, consistency_sdo, consistency_vsa) |> print()
# ===========================================================================
# §3.4 Version trends (release order per Table 1)
# ===========================================================================
orders <- list(
`Claude-Opus`   = c("claude-opus-4-1","claude-opus-4-5","claude-opus-4-6",
"claude-opus-4-7","claude-opus-4-8"),
`Claude-Sonnet` = c("claude-sonnet-4","claude-sonnet-4-5","claude-sonnet-4-6"),
GPT             = c("gpt-4o","gpt-4.1","gpt-5","gpt-5.1","gpt-5.2","gpt-5.4","gpt-5.5"),
Llama           = c("meta-llama-3-1-8b-instruct","meta-llama-3-3-70b-instruct",
"llama-4-maverick"),
Qwen            = c("qwen3-next-80b-a3b-instruct","qwen35-122b-a10b")
)
cat("\n== §3.4 within-family sequences (compare to the arrows in the text) ==\n")
di <- d |> column_to_rownames("m")
for (fam in names(orders)) {
seqs <- orders[[fam]]
cat(sprintf("%-14s SDO: %s\n", fam,
paste(round(di[seqs, "SDO"], 2), collapse = " -> ")))
cat(sprintf("%-14s VSA: %s\n", fam,
paste(round(di[seqs, "RWA"], 2), collapse = " -> ")))
}
# ===========================================================================
# §2.4 missingness identification (denominator check)
# SDO max n = 8 items x 5 reps = 40; VSA max n = 6 x 5 = 30.
# A mean of integer responses times the true n must be an integer.
# Expected: qwen35-122b-a10b consistent ONLY with n = 37 (3 missing);
#           gpt-oss-120b consistent with n = {36, 39} — n = 39 (1 missing)
#           is the value compatible with the recorded total of 4 missing.
# ===========================================================================
consistent_n <- function(mean_val, n_max) {
ns <- (n_max - 4):n_max
ns[abs(mean_val * ns - round(mean_val * ns)) < 1e-6]
}
cat("\n== §2.4 models whose SDO mean is NOT consistent with the full n = 40 ==\n")
for (i in seq_len(nrow(d))) {
ns <- consistent_n(d$SDO[i], 40)
if (!(40 %in% ns)) cat(sprintf("  %-30s consistent n: %s\n", d$m[i],
paste(ns, collapse = ", ")))
}
# ===========================================================================
# Table 2 cross-check
# table2_check.csv is written here BY DESIGN at 2dp display precision: it is
# the diff-target for the rendered Table 2, not an analysis source (see
# DEPOSIT_README). The manuscript's tbl-results reads it for display; every
# statistic, everywhere, is computed from the full-precision files.
# ===========================================================================
d |>
mutate(m = factor(m, levels = unname(unlist(orders)) |>
c("gpt-oss-20b","gpt-oss-120b","gemma-3-12b",
"claude-haiku-4-5") |> unique())) |>
arrange(m) |>
select(m, family, ecosystem, access, SDO, RWA,
consistency_sdo, consistency_vsa) |>
mutate(across(where(is.numeric), ~ round(.x, 2))) |>
write_csv(out_path("table2_check.csv"))
cat("\nWrote", out_path("table2_check.csv"), "— diff against Table 2 in the manuscript.\n")
# ===========================================================================
# §3.2 supplement (transplanted 8 July 2026 from verify_section6.R §6.6):
# Holm across the four contrasts, floor-coupling, and the doubled-tail
# enumeration behind the §2.5 exactness claim.
# ===========================================================================
p4 <- c(full_sdo = w1$p.value, full_vsa = w2$p.value,
restr_sdo = w3$p.value, restr_vsa = w4$p.value)
cat("\n== Holm across the four contrasts ==\n")
print(round(p.adjust(p4, method = "holm"), 4))
# Expected: full_sdo .4220 | full_vsa .1568 | restr_sdo .4220 | restr_vsa .0839
# Reported in §3.2 (B2): .42 / .157 / .42 / .084 — nothing survives correction.
cat("\n== Floor-coupling (mean vs dispersion), §3.2 ==\n")
cat(sprintf("rho(SDO mean, SDO dispersion) = %.4f  # expect .4549 -> reported .45\n",
cor(d$SDO, d$consistency_sdo, method = "spearman")))
cat(sprintf("rho(VSA mean, VSA dispersion) = %.4f  # expect -.0577 -> reported -.06\n",
cor(d$RWA, d$consistency_vsa, method = "spearman")))
perm_p_spearman <- function(x, y, B = 1e5) {
obs  <- abs(cor(rank(x), rank(y)))
sims <- replicate(B, abs(cor(rank(x), rank(sample(y)))))
mean(sims >= obs - 1e-12)
}
set.seed(2026)
cat(sprintf("permutation p (seed 2026, B = 1e5) = %.5f  # expect ~ .026\n",
perm_p_spearman(d$SDO, d$consistency_sdo)))
cat("\n== Exactness check: doubled-tail enumeration must equal wilcox.test ==\n")
enum_doubled <- function(y, in_g2) {
r <- rank(y); n2 <- sum(in_g2)
cs <- colSums(matrix(r[combn(length(y), n2)], nrow = n2))
obs <- sum(r[in_g2])
min(1, 2 * min(mean(cs >= obs - 1e-9), mean(cs <= obs + 1e-9)))
}
ow_l <- d$access == "open-weight"
cl_v <- d |> filter(family == "Claude")
ow_v <- d |> filter(access == "open-weight")
stopifnot(nrow(cl_v) == 9, nrow(ow_v) == 8)
ed <- c(full_sdo  = enum_doubled(d$consistency_sdo, ow_l),
full_vsa  = enum_doubled(d$consistency_vsa, ow_l),
restr_sdo = enum_doubled(c(cl_v$consistency_sdo, ow_v$consistency_sdo),
rep(c(FALSE, TRUE), c(9, 8))),
restr_vsa = enum_doubled(c(cl_v$consistency_vsa, ow_v$consistency_vsa),
rep(c(FALSE, TRUE), c(9, 8))))
print(round(ed, 6))
# Expected: .260279 | .052271 | .211024 | .020979
# (.05227127 and .02097902 are the values named in §2.5 / B1.)
stopifnot(max(abs(p4 - ed)) < 1e-9)          # the §2.5 exactness claim, asserted
cat("enumeration == wilcox.test on all four contrasts (< 1e-9)\n")
cat("\n== sessionInfo(): paste the R version + package versions into §2.5 ==\n")
sessionInfo()
# verify_tie_structure.R — 9 July 2026
# ---------------------------------------------------------------------------
# WHY THIS SCRIPT EXISTS (the sixth precision-class artifact, and the deepest):
#
# The by-model construct means and dispersions carry MATHEMATICALLY EXACT ties.
# Every mean is a rational number (sum of integers / n); every flagship-median
# dispersion is an exact multiple of sqrt(0.2) (a single one-point deviation in
# five otherwise-identical integer responses gives per-item SD = sqrt(0.2)
# EXACTLY, regardless of which integers — SD is translation-invariant). So:
#
#   SDO dispersion, true tie groups:  0 (x8) | sqrt(.2)/8 (x5, all Claude)
#                                     | sqrt(.03)... = 0.0684653 (x3)
#                                     | 0.1677051 (x2: gpt-4o = 3*sqrt(.2)/8
#                                       and gpt-5.1 = sqrt(1.8)/8 — EQUAL,
#                                       since sqrt(1.8) = 3*sqrt(.2))
#   SDO mean, true tie groups:        1.375 (x2) | 1.45 (x2) | 1.725 (x3)
#   VSA mean, true tie groups:        five exact pairs (-1.8, -7/6, -1.1,
#                                     -2/3, -8/15)
#   VSA dispersion, true tie groups:  0 (x6) | sqrt(.2)/6 (x5)
#
# Exact rank statistics are DISCONTINUOUS in ties: the exact conditional
# Wilcoxon p and Spearman rho jump when a tie breaks. Any pipeline that
# recomputes these aggregates through a float path (R sd()/mean(), pandas)
# perturbs identical quantities by ~1 ulp via translation noise — e.g.
# sd(c(1,1,1,1,2)) and sd(c(3,3,3,3,4)) are mathematically equal but differ
# in the last bit — and each regeneration breaks the ties DIFFERENTLY. This
# is what happened between the 7 and 8 July file vintages, and it is why
# E52/E53/E55 chased moving targets:
#
#   quantity                     true value      8 July "correction" (artifact)
#   Holm, both SDO contrasts     .4112 -> .41    .42        (E52)
#   rho(SDO mean, SDO disp)      .455639 -> .46  .45        (E53)
#   rho(VSA mean, VSA disp)      -.067185 -> -.07  -.06     (E53)
#   permutation p (SDO coupling) .0264 -> .026   .027       (E55)
#
# All four revert to the 7 July originals, which were computed on tie-intact
# data. The four exact p-values and their display forms are UNCHANGED:
# .25905576 / .05227127 / .20559441 / .02097902 -> .26 / .052 / .21 / .021.
# (The deposit-vintage .260279/.211024 do not reproduce from the raw data
# under any tie treatment; they are file-vintage artifacts. U statistics are
# unchanged by the tie breaks — 45.5/32.5/23.0/12.5 — which is why no
# existing check caught this.)
#
# THE FIX used here and recommended everywhere ranks are taken:
#   round(x, 12) before ranking. Ulp noise is ~1e-17; the smallest TRUE gap
#   between distinct dispersion values is 0.01256 (printed below). Twelve
#   decimals is therefore ten orders of magnitude of safety on either side.
#
# Runtime: ~2-4 min (two C(24,8) enumerations + B = 4e6 permutation draws).
# Requires R >= 4.6 and tidyverse. All expectations verified 9 July 2026 in
# exact rational arithmetic (Python Fractions + 60-digit Decimal) and by
# doubled-tail enumeration on the raw item-level file.
# ---------------------------------------------------------------------------
if (getRversion() < "4.6")
stop("R >= 4.6 required (exact wilcox.test with ties).")
suppressPackageStartupMessages(library(tidyverse))
# ---- data location (standard path block — identical across the R scripts) -----
.aai_script_dir <- function() {
fa <- grep("^--file=", commandArgs(FALSE), value = TRUE)
if (length(fa)) return(normalizePath(dirname(sub("^--file=", "", fa[[1]]))))
for (i in seq_len(sys.nframe())) {
of <- sys.frame(i)$ofile
if (!is.null(of)) return(normalizePath(dirname(of)))
}
normalizePath(getwd())
}
.aai_find_data <- function() {
env <- Sys.getenv("AAI_DATA_DIR", "")
if (nzchar(env)) return(normalizePath(env))
a <- commandArgs(trailingOnly = TRUE)
if (length(a) >= 1 && nzchar(a[[1]])) return(normalizePath(a[[1]]))
for (cand in c(file.path(.aai_script_dir(), "data_summaries"),
file.path(.aai_script_dir(), "..", "data_summaries"),
file.path(getwd(), "data_summaries"))) {
if (dir.exists(cand)) return(normalizePath(cand))
}
stop("Could not find the 'data_summaries' folder. Set AAI_DATA_DIR, pass it as ",
"the first argument, or run from inside the project.", call. = FALSE)
}
DATA_DIR <- .aai_find_data()
in_path <- function(f) file.path(DATA_DIR, f)
message("[paths] data_summaries -> ", DATA_DIR)
# -------------------------------------------------------------------------------
.results <- list()
check <- function(label, cond) {
ok <- isTRUE(cond)
.results[[length(.results) + 1]] <<- list(label = label, ok = ok)
cat(sprintf("[%s] %s\n", if (ok) "PASS" else "FAIL", label))
invisible(ok)
}
# ---- raw, keyed, tie-restored aggregates ---------------------------------------
raw <- read_csv(in_path("SDO_VSA_Results.csv"), show_col_types = FALSE,
col_types = cols(parse_error = "c", raw_response = "c",
.default = col_guess())) |>
mutate(m = str_remove(model, "^databricks-"))
sdo_rev <- c("sdo-q3", "sdo-q4", "sdo-q7", "sdo-q8")
vsa_rev <- c("vsa-q1", "vsa-q4", "vsa-q5")
raw <- raw |>
mutate(keyed = case_when(
category == "sdo" & question_id %in% sdo_rev ~ 8 - value,
category == "sdo" ~ value,
category == "vsa" & question_id %in% vsa_rev ~ -value,
TRUE ~ value))
TIE_DP <- 12   # tie-restoration precision: ulp noise ~1e-17 << 1e-12 << true gaps
agg <- raw |> filter(!is.na(keyed)) |>
group_by(m, category, question_id) |>
summarise(sd_i = sd(keyed), .groups = "drop") |>
group_by(m, category) |>
summarise(disp = round(mean(sd_i), TIE_DP), .groups = "drop") |>
left_join(raw |> filter(!is.na(keyed)) |> group_by(m, category) |>
summarise(mn = round(mean(keyed), TIE_DP), .groups = "drop"),
by = c("m", "category"))
wide <- agg |>
pivot_wider(names_from = category, values_from = c(disp, mn)) |>
mutate(family = case_when(str_detect(m, "claude") ~ "Claude",
str_starts(m, "gpt-oss") ~ "GPT-OSS",
str_starts(m, "gpt") ~ "GPT",
str_detect(m, "qwen") ~ "Qwen",
str_detect(m, "gemma") ~ "Gemma",
str_detect(m, "llama") ~ "Llama"),
access = if_else(family %in% c("Claude", "GPT"), "flagship", "open-weight")) |>
arrange(m)   # E55 protocol: deterministic row order before any seeded draw
stopifnot(nrow(wide) == 24, sum(wide$access == "flagship") == 16)
# ---- 1. the true tie structure, demonstrated ------------------------------------
cat("\n---- 1. true tie structure (after 12-dp tie restoration) ----\n")
gap <- wide |> pull(disp_sdo) |> unique() |> sort() |> diff() |> min()
cat(sprintf("    smallest TRUE gap between distinct SDO dispersion values: %.5f\n", gap))
check("1.0 tie-restoration margin: min true gap > 1e-6 >> 1e-12 rounding", gap > 1e-6)
tie_n <- function(v) sort(as.integer(table(v)[table(v) > 1]))
check("1.1 SDO dispersion tie groups are {2, 3, 5, 8}",
identical(tie_n(wide$disp_sdo), c(2L, 3L, 5L, 8L)))
check("1.2 VSA dispersion tie groups are {5, 6}",
identical(tie_n(wide$disp_vsa), c(5L, 6L)))
check("1.3 SDO mean tie groups are {2, 2, 3}",
identical(tie_n(wide$mn_sdo), c(2L, 2L, 3L)))
check("1.4 VSA mean tie groups are five exact pairs",
identical(tie_n(wide$mn_vsa), c(2L, 2L, 2L, 2L, 2L)))
check("1.5 the radical-equal pair: gpt-4o (3*sqrt(.2)/8) == gpt-5.1 (sqrt(1.8)/8)",
{ d <- wide |> filter(m %in% c("gpt-4o", "gpt-5.1")) |> pull(disp_sdo)
d[1] == d[2] && abs(d[1] - 3 * sqrt(0.2) / 8) < 1e-9 })
# ---- 2. the four exact tests on the TRUE structure -------------------------------
cat("\n---- 2. exact tests, Holm ----\n")
fl <- wide |> filter(access == "flagship");  ow <- wide |> filter(access == "open-weight")
cl <- wide |> filter(family == "Claude")
p4 <- c(
full_sdo  = wilcox.test(fl$disp_sdo, ow$disp_sdo, exact = TRUE)$p.value,
full_vsa  = wilcox.test(fl$disp_vsa, ow$disp_vsa, exact = TRUE)$p.value,
restr_sdo = wilcox.test(cl$disp_sdo, ow$disp_sdo, exact = TRUE)$p.value,
restr_vsa = wilcox.test(cl$disp_vsa, ow$disp_vsa, exact = TRUE)$p.value)
cat("    exact p (8dp): ", paste(sprintf("%s=%.8f", names(p4), p4), collapse = "  "), "\n")
check("2.1 true exact p = .25905576 / .05227127 / .20559441 / .02097902",
max(abs(p4 - c(0.25905576, 0.05227127, 0.20559441, 0.02097902))) < 5e-8)
check("2.2 display forms unchanged: .26 / .052 / .21 / .021",
round(p4[[1]], 2) == 0.26 && round(p4[[2]], 3) == 0.052 &&
round(p4[[3]], 2) == 0.21 && round(p4[[4]], 3) == 0.021)
enum_doubled <- function(y, in_g2) {
r <- rank(y); n2 <- sum(in_g2)
cs <- colSums(matrix(r[combn(length(y), n2)], nrow = n2))
obs <- sum(r[in_g2])
min(1, 2 * min(mean(cs >= obs - 1e-9), mean(cs <= obs + 1e-9)))
}
ed <- c(
full_sdo  = enum_doubled(c(fl$disp_sdo, ow$disp_sdo), rep(c(FALSE, TRUE), c(16, 8))),
restr_sdo = enum_doubled(c(cl$disp_sdo, ow$disp_sdo), rep(c(FALSE, TRUE), c(9, 8))))
check("2.3 wilcox.test == doubled-tail enumeration on the two SDO contrasts (< 1e-9)",
abs(p4[["full_sdo"]] - ed[["full_sdo"]]) < 1e-9 &&
abs(p4[["restr_sdo"]] - ed[["restr_sdo"]]) < 1e-9)
holm <- p.adjust(p4, method = "holm")
cat("    Holm (6dp):    ", paste(sprintf("%s=%.6f", names(holm), holm), collapse = "  "), "\n")
check("2.4 Holm = .411189 / .156814 / .411189 / .083916 -> B2 carries .41, NOT .42",
max(abs(holm - c(0.411189, 0.156814, 0.411189, 0.083916))) < 5e-7)
check("2.5 nothing survives correction (unchanged conclusion)", all(holm > 0.05))
# ---- 3. coupling (B3) on the TRUE structure ---------------------------------------
cat("\n---- 3. floor-coupling ----\n")
rho_sdo <- cor(wide$mn_sdo, wide$disp_sdo, method = "spearman")
rho_vsa <- cor(wide$mn_vsa, wide$disp_vsa, method = "spearman")
cat(sprintf("    rho(SDO mean, SDO disp) = %.6f | rho(VSA mean, VSA disp) = %.6f\n",
rho_sdo, rho_vsa))
check("3.1 rho_SDO = .455639 -> B3 carries .46, NOT .45", abs(rho_sdo - 0.455639) < 5e-6)
check("3.2 rho_VSA = -.067185 -> B3 carries -.07, NOT -.06", abs(rho_vsa + 0.067185) < 5e-6)
perm_p <- function(x, y, B = 4e6, seed = 2026) {
set.seed(seed)
rx <- rank(x) - mean(rank(x)); ry <- rank(y) - mean(rank(y))
obs <- abs(sum(rx * ry)); n <- length(ry); hits <- 0L
for (b in seq_len(B))
if (abs(sum(rx * ry[sample.int(n)])) >= obs - 1e-9) hits <- hits + 1L
hits / B
}
pp <- perm_p(wide$mn_sdo, wide$disp_sdo)
cat(sprintf("    permutation p (m-sorted, seed 2026, B = 4e6) = %.5f\n", pp))
# Pooled reference on true ranks: .026443, MC SE 6.6e-5 (B = 6e6, 9 July) —
# 95% CI [.0263, .0266], below the .0265 display boundary: reports as .026.
check("3.3 permutation p within .0264 +/- .0006 -> B3 carries .026, NOT .027",
abs(pp - 0.0264) < 6e-4)
# ---- 4. diagnostics: YOUR local by-model files -------------------------------------
cat("\n---- 4. file-vintage diagnostics (informational; no checks) ----\n")
diag_files <- c("attitude_consistency_by_model.csv",
"attitude_sdo_by_model.csv", "attitude_rwa_by_model.csv")
if (all(file.exists(in_path(diag_files)))) {
consf <- read_csv(in_path(diag_files[1]), show_col_types = FALSE)
sdof  <- read_csv(in_path(diag_files[2]), show_col_types = FALSE)
rwaf  <- read_csv(in_path(diag_files[3]), show_col_types = FALSE)
probe <- function(vals, ms, label) {
v <- vals[match(ms, names(vals))]
cat(sprintf("    %-34s %s\n", label,
if (length(unique(v)) == 1) "TIED (as it should be)"
else sprintf("*** BROKEN into %d values (spread %.2e) ***",
length(unique(v)), diff(range(v)))))
}
cv <- setNames(consf$consistency_sdo, consf$m)
probe(cv, c("claude-opus-4-7","claude-opus-4-8","claude-sonnet-4",
"claude-sonnet-4-5","claude-sonnet-4-6"), "SDO disp 5-way (sqrt(.2)/8):")
probe(cv, c("claude-haiku-4-5","gemma-3-12b","gpt-5.4"),   "SDO disp 3-way:")
probe(cv, c("gpt-4o","gpt-5.1"),                            "SDO disp radical pair:")
probe(setNames(consf$consistency_vsa, consf$m),
c("claude-opus-4-5","claude-opus-4-6","claude-sonnet-4-5",
"gpt-5.2","meta-llama-3-3-70b-instruct"),           "VSA disp 5-way (sqrt(.2)/6):")
probe(setNames(sdof$SDO, sdof$m),
c("claude-sonnet-4-5","claude-sonnet-4-6","gpt-5.2"), "SDO mean 3-way (1.725):")
rv <- setNames(rwaf$RWA, rwaf$m)
probe(rv, c("claude-opus-4-6","meta-llama-3-3-70b-instruct"), "VSA mean pair (-1.8):")
probe(rv, c("claude-opus-4-8","meta-llama-3-1-8b-instruct"),  "VSA mean pair (-2/3):")
probe(rv, c("gpt-4.1","qwen3-next-80b-a3b-instruct"),         "VSA mean pair (-1.1):")
cat("    Any BROKEN line above means that file, used as an analysis source,\n",
"    silently shifts the exact tests / Spearman ranks. Regenerate the\n",
"    by-model CSVs with round(., 12) applied at write time (one mutate in\n",
"    attitude_evolution.R), or keep computing from raw as this script does.\n", sep = "")
} else cat("    (by-model CSVs not found next to the raw file; skipped)\n")
# ---- tally ---------------------------------------------------------------------
fails <- sum(!vapply(.results, function(x) x$ok, logical(1)))
cat(sprintf("\n==== %d checks run, %d failed ====\n", length(.results), fails))
if (fails == 0) {
cat("R side confirms the exact-arithmetic values. Next steps:\n",
"  1. python3 apply_tie_corrections.py <path-to-qmd>   (B2 .42->.41; B3 .45->.46,\n",
"     -.06->-.07, .027->.026, header note) — 5 assert-verified edits\n",
"  2. Re-correct the deposit scripts' expectations (verify_section6.R v3: the\n",
"     Holm-.42, rho-.45/-.06 and perm-window checks; verify_section3_stats_v2.R:\n",
"     the .260279/.211024/.4220/.4549/-.0577 comments)\n",
"  3. Regenerate the by-model CSVs tie-stably (round 12dp at write) before deposit;\n",
"     note the convention in DEPOSIT_README\n", sep = "")
} else {
stop("Some checks failed. If §1 fails, this raw CSV differs from the one verified ",
"on 9 July — stop and reconcile raw-file provenance first.")
}
